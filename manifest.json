{
  "manifest_version": 3,
  "name": "Kokoro Reader",
  "version": "1.0.4",
  "description": "Read selected text aloud using Kokoro-FastAPI or another OpenAI-compatible text-to-speech server.",
  "homepage_url": "https://github.com/JCallicoat/kokoro-reader",
  "developer": {
    "name": "JCallicoat",
    "url": "https://github.com/JCallicoat"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "common/settings.js",
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Kokoro Reader settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Read selection aloud"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kokoro-reader@jcallicoat",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "minimum_chrome_version": "121"
}
